  display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;
  border:1.5px solid rgba(17,17,16,0.18);border-radius:4px;
  font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:500;
  color:#3D3A36;text-decoration:none;
  transition:border-color 0.18s,color 0.18s,transform 0.18s,box-shadow 0.18s;
}
.btn-border-light:hover{border-color:var(--ink);color:var(--ink);transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,0,0,0.1);}
.btn-border-light:active{transform:translateY(0);}

/* tags */
.tag{
  font-family:'JetBrains Mono',monospace;font-size:10px;
  padding:3px 8px;background:#F2F0EB;color:var(--muted);
  border:1px solid var(--rule);border-radius:2px;
}
.tag-dark{
  background:rgba(245,240,230,0.05);color:rgba(245,240,230,0.35);
  border-color:rgba(245,240,230,0.07);
}
.tag-row{display:flex;flex-wrap:wrap;gap:5px;}
.tag-row-dark .tag{background:rgba(245,240,230,0.05);color:rgba(245,240,230,0.35);border-color:rgba(245,240,230,0.07);}

/* pulse dots */
.pulse-dot{
  display:inline-block;width:8px;height:8px;border-radius:50%;flex-shrink:0;
  animation:pulse 2.2s ease infinite;
}
.pulse-dot.orange{background:var(--accent);}
.pulse-dot.green{background:oklch(60% 0.18 152);}
.pulse-dot-sm{width:6px;height:6px;}
.green-dim{background:oklch(55% 0.16 152);}

/* link muted */
.link-muted{
  font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:500;
  color:var(--placeholder);text-decoration:none;
  transition:color 0.18s;
}
.link-muted:hover{color:var(--ink);}
.link-muted-sm{
  font-family:'JetBrains Mono',monospace;font-size:11px;
  color:var(--placeholder);text-decoration:none;
  transition:color 0.18s;
}
.link-muted-sm:hover{color:var(--ink);}
.link-muted-dark{
  font-family:'Space Grotesk',sans-serif;font-size:13px;font-weight:500;
  color:rgba(245,240,230,0.3);text-decoration:none;
  transition:color 0.18s;
}
.link-muted-dark:hover{color:rgba(245,240,230,0.75);}

/* ── Hero ──────────────────────────────────────────── */
#hero{
  position:relative;min-height:100vh;
  background:var(--dark);
  display:flex;align-items:flex-start;overflow:hidden;
}
.hero-icon-grid-wrap{
  position:absolute;inset:-300px;z-index:0;
  pointer-events:none;overflow:hidden;
}
.hero-icon-grid{
  display:grid;
  grid-template-columns:repeat(22,72px);
  grid-auto-rows:72px;
  gap:44px;
  animation:diagDrift 20s linear infinite;
}
.hero-icon-grid .hn{
  font-size:34px;color:var(--cream);opacity:0.07;
  display:flex;align-items:center;justify-content:center;
  width:72px;height:72px;
}
#hero .dashed-cols{padding:0 48px;}
#hero .dash-col{border-left:1px dashed rgba(245,240,230,0.05);}
.hero-stripe{
  position:absolute;top:0;left:0;right:0;height:3px;
  background:var(--accent);z-index:2;
}
.hero-vignette{
  position:absolute;inset:0;
  background:radial-gradient(ellipse at 60% 50%,transparent 30%,rgba(14,14,12,0.7) 100%);
  z-index:1;pointer-events:none;
}
.hero-inner{
  --hero-primary:var(--cream);
  --hero-accent:var(--accent);
  display:flex;align-items:center;justify-content:space-between;gap:48px;
  padding:calc(64px + 80px) 96px 80px;width:100%;box-sizing:border-box;
  min-height:100vh;
}
.hero-left{
  display:flex;flex-direction:column;gap:24px;max-width:640px;
}
.hero-eyebrow{display:flex;flex-direction:column;gap:12px;}
.hero-location{
  display:flex;align-items:center;gap:12px;
  font-family:'JetBrains Mono',monospace;font-size:11px;
  letter-spacing:0.18em;text-transform:uppercase;color:var(--accent);
}
.loc-line{display:block;width:24px;height:1px;background:var(--accent);}
.hero-thinking-pill{
  display:inline-flex;align-items:center;gap:8px;
  padding:5px 14px;border:1px solid rgba(245,240,230,0.10);
  border-radius:99px;width:fit-content;
  font-family:'JetBrains Mono',monospace;font-size:10px;
  color:rgba(245,240,230,0.45);letter-spacing:0.05em;
  transition:border-color 0.18s;
}
.hero-thinking-pill:hover{border-color:rgba(245,240,230,0.25);}
.hero-name{line-height:0.88;}
.name-line-1{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(80px,11vw,152px);line-height:0.88;
  color:var(--hero-primary);letter-spacing:0.01em;
}
.name-line-2{
  font-family:'Bebas Neue',sans-serif;
  font-size:clamp(80px,11vw,152px);line-height:0.88;
  color:var(--hero-accent);letter-spacing:0.01em;
}
.hero-subtitle{
  font-family:'Space Grotesk',sans-serif;font-size:16px;line-height:1.7;
  color:rgba(245,240,230,0.72);max-width:400px;
}
.hero-ctas{
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding-top:8px;
}
.hero-ctas .btn-split-text{
  background:rgba(245,240,230,0.06);
  border-color:rgba(245,240,230,0.10);
  color:var(--hero-primary);
}
.hero-ctas .btn-split-icon{
  background:var(--hero-accent);
}
.hero-ctas .btn-outline-text{
  border-color:rgba(245,240,230,0.52);
  background:rgba(245,240,230,0.04);
  color:rgba(245,240,230,0.86);
}
.hero-ctas .btn-outline-icon{
  border-color:rgba(245,240,230,0.52);
  background:rgba(245,240,230,0.08);
  color:rgba(245,240,230,0.78);
}
.hero-ctas .btn-split:hover,
.hero-ctas .btn-outline:hover{
  box-shadow:none;
}
.hero-ctas .btn-outline:hover .btn-outline-text,
.hero-ctas .btn-outline:hover .btn-outline-icon{
  border-color:rgba(245,240,230,0.78);
  background:rgba(245,240,230,0.12);
  color:var(--hero-primary);
}
.hero-ctas .btn-split:focus-visible,
.hero-ctas .btn-outline:focus-visible{
  outline:2px solid var(--hero-accent);
  outline-offset:3px;
  box-shadow:0 0 0 4px oklch(62% 0.20 50 / 0.18);
}

/* Status panel */
.hero-status{
  display:flex;flex-direction:column;gap:0;
  padding-left:48px;border-left:1px solid rgba(245,240,230,0.07);
  flex-shrink:0;min-width:220px;
}
.status-block{padding:22px 0;border-bottom:1px solid rgba(245,240,230,0.06);}
.status-availability{padding-top:0;}
.status-core{border-bottom:none;padding-bottom:0;}
.status-label{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  color:rgba(245,240,230,0.28);margin-bottom:10px;
}
.status-val{display:flex;align-items:center;gap:9px;font-family:'Space Grotesk',sans-serif;font-size:14px;font-weight:500;color:var(--cream);}
.status-stats{
  display:grid;grid-template-columns:1fr 1fr;gap:0;
  padding:0;border-bottom:1px solid rgba(245,240,230,0.06);
}
.stat-cell{padding:22px 0;}
.stat-cell-left{border-right:1px solid rgba(245,240,230,0.06);padding-right:0;}
.stat-label{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  color:rgba(245,240,230,0.28);margin-bottom:8px;
}
.stat-num{
  font-family:'Bebas Neue',sans-serif;font-size:46px;
  line-height:1;color:var(--hero-primary);letter-spacing:0.01em;
}
.stat-unit,.stat-plus{color:var(--hero-accent);}
.stat-unit{font-size:24px;}
.core-tags{display:flex;flex-wrap:wrap;gap:5px;padding-top:10px;}
.core-tag{
  font-family:'JetBrains Mono',monospace;font-size:10px;padding:4px 10px;
  background:rgba(245,240,230,0.05);border:1px solid rgba(245,240,230,0.10);
  color:rgba(245,240,230,0.6);border-radius:2px;
}
.core-tag-accent{
  background:oklch(62% 0.20 50 / 0.10);
  border-color:oklch(62% 0.20 50 / 0.28);
  color:var(--accent);
}

/* Scroll indicator */
.hero-scroll{
  position:absolute;bottom:36px;left:50%;
  transform:translateX(-50%);
  display:flex;flex-direction:column;align-items:center;gap:8px;z-index:3;
}
.scroll-hint{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.16em;text-transform:uppercase;
  color:rgba(245,240,230,0.2);
}
.scroll-line{
  width:1px;height:44px;
  background:linear-gradient(to bottom,rgba(245,240,230,0.25),transparent);
}

/* ── About ─────────────────────────────────────────── */
.about-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:center;
}
.about-text{display:flex;flex-direction:column;gap:28px;}
.about-body{display:flex;flex-direction:column;gap:14px;}
.about-body p{
  font-family:'Space Grotesk',sans-serif;font-size:16px;
  line-height:1.72;color:var(--muted);
}
.about-actions{display:flex;gap:10px;flex-wrap:wrap;padding-top:4px;}
.about-photo-wrap{
  display:flex;flex-direction:column;gap:12px;align-items:center;
}
.about-photo{
  width:100%;max-width:360px;height:auto;
  border-radius:4px;
  border:1px solid rgba(17,17,16,0.08);
  display:block;
}
.photo-caption{
  display:flex;align-items:center;gap:8px;
  font-family:'JetBrains Mono',monospace;font-size:10px;
  color:var(--placeholder);letter-spacing:0.06em;
}
.photo-rule{display:block;width:14px;height:1px;background:#C8C4BC;}

/* ── Stack ─────────────────────────────────────────── */
.stack-header{padding-bottom:40px!important;}
.marquee-wrap{
  border-top:1px solid rgba(245,240,230,0.05);
  border-bottom:1px solid rgba(245,240,230,0.05);
}
.marquee-row{position:relative;overflow:hidden;padding:18px 0;}
.marquee-row-border{border-bottom:1px solid rgba(245,240,230,0.04);}
.marquee-fade{
  position:absolute;top:0;bottom:0;width:120px;z-index:2;pointer-events:none;
}
.marquee-fade-left{left:0;background:linear-gradient(to right,#111110,transparent);}
.marquee-fade-right{right:0;background:linear-gradient(to left,#111110,transparent);}
.marquee-track{display:flex;width:max-content;}
.marquee-fwd{animation:marquee 26s linear infinite;}
.marquee-rev{animation:marqueeRev 26s linear infinite;}
.marquee-item{
  display:inline-flex;align-items:center;gap:12px;
  padding:0 32px;flex-shrink:0;
}
.marquee-item img{display:block;flex-shrink:0;}
.marquee-item span{
  font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;
  white-space:nowrap;letter-spacing:-0.01em;
}
.stack-grid-wrap{padding-top:0!important;}
.stack-grid{
  display:grid;grid-template-columns:repeat(5,1fr);
  border:1px solid rgba(245,240,230,0.07);
  border-radius:4px;overflow:hidden;
}
.stack-col{
  padding:28px 24px;
  border-right:1px solid rgba(245,240,230,0.06);
  background:#181816;
  display:flex;flex-direction:column;gap:18px;
  transition:background 0.18s;
}
.stack-col:hover{background:#1E1D1A;}
.stack-col:nth-child(even){background:#1A1918;}
.stack-col:nth-child(even):hover{background:#1E1D1A;}
.stack-col-last{border-right:none;}
.stack-col-header{display:flex;flex-direction:column;gap:8px;}
.stack-accent-bar{display:block;width:20px;height:2px;background:var(--accent);border-radius:1px;}
.stack-cat-label{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.14em;text-transform:uppercase;color:var(--accent);
}
.stack-items{display:flex;flex-direction:column;gap:9px;}
.stack-item{
  display:flex;align-items:center;gap:7px;
  font-family:'Space Grotesk',sans-serif;font-size:13px;
  color:#5A5650;
}
.stack-item::before{
  content:'';display:block;width:3px;height:3px;
  border-radius:50%;background:rgba(245,240,230,0.12);flex-shrink:0;
}
.stack-item-primary{color:var(--cream);}
.stack-item-primary::before{background:var(--accent);}

/* ── Projects ──────────────────────────────────────── */
.projects-inner{padding:96px 48px!important;}
.projects-header{
  display:flex;align-items:flex-end;justify-content:space-between;
  gap:24px;border-bottom:1px solid rgba(17,17,16,0.1);
  padding-bottom:32px;margin-bottom:3px;
}
.projects-featured{
  background:#FFFFFF;overflow:hidden;
  display:grid;grid-template-columns:1fr 1fr;
  margin-bottom:3px;border-radius:2px;min-height:380px;
}
.proj-info{
  padding:44px 40px;
  display:flex;flex-direction:column;justify-content:space-between;gap:24px;
}
.proj-eyebrow{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;
}
.proj-title{
  font-family:'Bebas Neue',sans-serif;font-size:38px;
  line-height:1.05;color:var(--ink);letter-spacing:0.01em;margin-bottom:14px;
}
.proj-desc{
  font-family:'Space Grotesk',sans-serif;font-size:15px;
  line-height:1.68;color:var(--muted);margin-bottom:18px;
}
.proj-stat-row{
  display:flex;align-items:baseline;gap:10px;
  margin-bottom:20px;padding-bottom:18px;
  border-bottom:1px solid #ECEAE3;
}
.proj-stat-num{
  font-family:'Bebas Neue',sans-serif;font-size:42px;
  line-height:0.9;color:var(--accent);letter-spacing:0.01em;
}
.proj-stat-label{
  font-family:'JetBrains Mono',monospace;font-size:10px;
  letter-spacing:0.08em;text-transform:uppercase;color:var(--placeholder);
}
.proj-tags{display:flex;flex-wrap:wrap;gap:5px;}
.proj-actions{
  display:flex;align-items:center;gap:12px;
  padding-top:20px;border-top:1px solid #ECEAE3;
}
.proj-meta{
  margin-left:auto;font-family:'JetBrains Mono',monospace;
  font-size:10px;color:var(--placeholder);
}
.proj-mockup-wrap{
  position:relative;overflow:hidden;
  display:flex;align-items:flex-start;justify-content:center;
  padding:28px 28px 0;min-height:340px;
  transition:background 0.3s;
}
.proj-mockup-inner{
  width:100%;border-radius:6px 6px 0 0;
  overflow:hidden;box-shadow:0 12px 48px rgba(0,0,0,0.14);
  height:100%;
}

/* project image slots */
.proj-img-slot{
  width:100%;height:100%;overflow:hidden;border-radius:6px 6px 0 0;
  display:flex;align-items:flex-start;justify-content:center;
}
.proj-img-slot img{
  width:100%;height:100%;object-fit:cover;object-position:center top;display:block;
}
/* all images use cover to avoid bands */

/* project tabs */
.proj-tabs{
  display:grid;grid-template-columns:repeat(5,1fr);gap:3px;
}
.proj-tab{
  background:#FFFFFF;padding:20px 24px;
  border-top:3px solid transparent;
  transition:border-color 0.2s,background 0.2s;
  cursor:pointer;
}
.proj-tab:hover{background:#FAFAF8;}
.proj-tab-active{border-top-color:var(--accent)!important;}
.tab-num{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.12em;text-transform:uppercase;
  color:var(--placeholder);margin-bottom:8px;
  transition:color 0.2s;
}
.proj-tab-active .tab-num{color:var(--accent);}
.tab-title{
  font-family:'Bebas Neue',sans-serif;font-size:18px;
  line-height:1.1;color:var(--placeholder);margin-bottom:5px;
  transition:color 0.2s;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.proj-tab-active .tab-title{color:var(--ink);}
.tab-meta{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--placeholder);}

/* ── Mockups ───────────────────────────────────────── */
.mockup{height:100%;display:flex;flex-direction:column;}
.mockup-light{background:#FAFAF8;}
.mockup-dark{background:var(--dark);}
.mock-bar{
  height:26px;flex-shrink:0;display:flex;align-items:center;
  padding:0 10px;gap:5px;
}
.mock-bar-light{background:#EDECEA;border-bottom:1px solid var(--rule);}
.mock-bar-dark{background:#1C1B18;border-bottom:1px solid rgba(245,240,230,0.06);}
.dot{width:7px;height:7px;border-radius:50%;}
.dot-red{background:#FF605C;} .dot-yellow{background:#FFBD44;} .dot-green{background:#00CA4E;}
.dot-dark{background:rgba(245,240,230,0.12);}
.mock-url-bar{
  flex:1;margin-left:6px;height:15px;background:#FFFFFF;
  border-radius:3px;border:1px solid var(--rule);
  padding:0 7px;display:flex;align-items:center;
}
.mock-url-bar-dark{background:rgba(245,240,230,0.04);border-color:rgba(245,240,230,0.06);}
.mock-url{font-family:'JetBrains Mono',monospace;font-size:8px;color:var(--placeholder);}
.mock-url-dark{color:#5A5650;}

/* kanban */
.mock-kanban{flex:1;display:flex;gap:5px;padding:10px;overflow:hidden;}
.kanban-col{flex:1;background:#F4F2ED;border-radius:2px;padding:8px;display:flex;flex-direction:column;gap:4px;}
.kanban-col-active{background:oklch(62% 0.20 50 / 0.06);border:1px solid oklch(62% 0.20 50 / 0.22);}
.kanban-col-label{
  font-family:'JetBrains Mono',monospace;font-size:7px;font-weight:700;
  color:var(--placeholder);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:3px;
}
.kanban-col-label-active{color:var(--accent);}
.kanban-card{background:#FFFFFF;border-radius:2px;padding:7px 8px;border:1px solid var(--rule);height:22px;}

/* store */
.mock-store{flex:1;padding:10px;display:flex;flex-direction:column;gap:8px;overflow:hidden;}
.store-toolbar{display:flex;gap:6px;}
.store-search-active{width:90px;height:20px;background:oklch(62% 0.20 50 / 0.15);border-radius:2px;border:1px solid oklch(62% 0.20 50 / 0.3);}
.store-search-filler{flex:1;height:20px;background:#F0EEEA;border-radius:2px;}
.store-cta-dark{width:50px;height:20px;background:var(--ink);border-radius:2px;}
.store-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;flex:1;}
.store-card{background:#F0EEEA;border-radius:2px;padding:6px;border:1px solid var(--rule);}
.store-card-accent{background:oklch(62% 0.20 50 / 0.06);border-color:oklch(62% 0.20 50 / 0.25);}

/* api log */
.mock-api{flex:1;padding:12px;display:flex;flex-direction:column;gap:6px;overflow:hidden;font-family:'JetBrains Mono',monospace;}
.api-row{
  font-size:8.5px;color:rgba(245,240,230,0.25);padding:5px 8px;
  background:rgba(245,240,230,0.08);border-radius:2px;letter-spacing:0.02em;
}
.api-row-active{color:var(--accent);background:rgba(245,240,230,0.18);}
.api-stats{margin-top:4px;display:flex;gap:6px;}
.api-stat{
  flex:1;background:rgba(245,240,230,0.04);border-radius:2px;
  padding:6px 8px;border:1px solid rgba(245,240,230,0.06);
}
.api-stat-label{font-size:7px;color:rgba(245,240,230,0.2);}
.api-stat-val{font-size:11px;color:var(--accent);margin-top:2px;}
.api-stat-dim{color:rgba(245,240,230,0.5);}

/* analytics */
.mock-analytics{flex:1;padding:12px;display:flex;flex-direction:column;gap:8px;overflow:hidden;}
.analytics-kpis{display:flex;gap:6px;}
.kpi{
  flex:1;background:rgba(245,240,230,0.04);border-radius:2px;
  padding:6px 8px;border:1px solid rgba(245,240,230,0.06);
}
.kpi-label{font-family:'JetBrains Mono',monospace;font-size:7px;color:rgba(245,240,230,0.2);}
.kpi-val{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--accent);margin-top:2px;}
.kpi-dim{color:rgba(245,240,230,0.5);}
.analytics-chart{
  flex:1;display:flex;align-items:flex-end;gap:3px;
  border-bottom:1px solid rgba(245,240,230,0.06);padding-bottom:2px;
}
.bar{flex:1;background:rgba(245,240,230,0.10);border-radius:2px 2px 0 0;}
.bar-accent{background:var(--accent);}

/* ── Experience ────────────────────────────────────── */
.exp-header{margin-bottom:56px;}
.exp-timeline{max-width:760px;}
.exp-row{
  display:grid;grid-template-columns:160px 32px 1fr;
  gap:0;padding:0 0 48px;position:relative;
}
.exp-date{padding-top:4px;padding-right:24px;}
.exp-period{
  font-family:'JetBrains Mono',monospace;font-size:11px;
  color:var(--placeholder);line-height:1.6;
}
.exp-period-active{color:var(--accent);}
.exp-current{
  font-family:'JetBrains Mono',monospace;font-size:9px;
  letter-spacing:0.1em;font-weight:700;
  color:var(--accent);margin-top:5px;
}
.exp-line{display:flex;flex-direction:column;align-items:center;position:relative;}
.exp-dot{
  width:12px;height:12px;border-radius:50%;
  background:#DEDAD1;border:2px solid transparent;
