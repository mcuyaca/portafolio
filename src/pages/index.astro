---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/ui/Preloader.astro';
import ProgressBar from '../components/ui/ProgressBar.astro';
import GrainCursor from '../components/ui/GrainCursor.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Stack from '../components/sections/Stack.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Writing from '../components/sections/Writing.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/sections/Footer.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? 'YOUR_TURNSTILE_SITE_KEY';
---
<BaseLayout turnstileSiteKey={turnstileSiteKey}>
  <Preloader />
  <ProgressBar />
  <GrainCursor />
  <Nav />
  <Hero />
  <About />
  <Stack />
  <Projects />
  <Experience />
  <Writing />
  <Contact turnstileSiteKey={turnstileSiteKey} />
  <Footer />
</BaseLayout>
