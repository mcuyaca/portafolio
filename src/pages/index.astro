---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? 'YOUR_TURNSTILE_SITE_KEY';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Primary SEO -->
  <title>Manuel Cuya — Full Stack Developer & EDI Engineer</title>
  <meta name="description" content="Full Stack Developer and EDI Engineer based in Lima, Peru. I build web products end-to-end with TypeScript, Angular, React, Node.js and C#.">
  <meta name="keywords" content="Manuel Cuya, Full Stack Developer, EDI Developer, TypeScript, Angular, React, Node.js, C#, XSLT, XML, Lima Peru">
  <meta name="author" content="Manuel Cuya">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://mcuyaca.dev">

  <!-- Open Graph (LinkedIn, Slack, WhatsApp) -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://mcuyaca.dev">
  <meta property="og:title" content="Manuel Cuya — Full Stack Developer & EDI Engineer">
  <meta property="og:description" content="Full Stack Developer and EDI Engineer based in Lima, Peru. TypeScript, Angular, React, Node.js, C#, XSLT, XML.">
  <meta property="og:image" content="https://mcuyaca.dev/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Manuel Cuya Portfolio">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Manuel Cuya — Full Stack Developer & EDI Engineer">
  <meta name="twitter:description" content="Full Stack Developer and EDI Engineer based in Lima, Peru. TypeScript, Angular, React, Node.js, C#.">
  <meta name="twitter:image" content="https://mcuyaca.dev/og-image.png">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link href="https://unpkg.com/@hackernoon/pixel-icon-library/fonts/iconfont.css" rel="stylesheet">
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body>

<!-- Preloader -->
<div id="mc-preloader">
  <div class="pre-logo"><span class="accent">/</span>MCUYA</div>
  <div class="pre-track"><div class="pre-bar"></div></div>
  <div class="pre-label">Initializing</div>
</div>

<!-- Scroll progress bar -->
<div id="mc-progress"></div>

<!-- Custom cursor -->
<div id="mc-cursor">
  <div class="cur-h"></div>
  <div class="cur-v"></div>
</div>

<!-- ══ NAV ══════════════════════════════════════════════ -->
<nav id="mc-nav">
  <a href="#hero" class="nav-brand"><span class="accent">/</span>mcuya</a>
  <div class="nav-links mc-nav-links">
    <a href="#about"      class="nav-link" data-i18n="navAbout">About</a>
    <a href="#stack"      class="nav-link" data-i18n="navStack">Stack</a>
    <a href="#projects"   class="nav-link" data-i18n="navWork">Work</a>
    <a href="#experience" class="nav-link" data-i18n="navExp">Exp</a>
    <a href="#writing"    class="nav-link" data-i18n="navWriting">Writing</a>
    <a href="#contact"    class="nav-link" data-i18n="navContact">Contact</a>
  </div>
  <button id="lang-toggle" aria-label="Toggle language">
    <span id="lang-en" class="lang-pill lang-active">EN</span>
    <span id="lang-es" class="lang-pill">ES</span>
  </button>
  <a href="#contact" class="nav-cta">
    <span class="nav-cta-text">Get in Touch</span>
    <span class="nav-cta-arrow">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </a>
</nav>

<!-- ══ HERO ════════════════════════════════════════════ -->
<section id="hero">
  <!-- Pixel icon grid -->
  <div aria-hidden="true" class="hero-icon-grid-wrap">
    <div id="hero-icons" class="hero-icon-grid"></div>
  </div>
  <!-- Dashed columns -->
  <div class="dashed-cols" aria-hidden="true">
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
  </div>
  <!-- Accent stripe -->
  <div class="hero-stripe" aria-hidden="true"></div>
  <!-- Vignette -->
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="mc-hero-content hero-inner">
    <div class="hero-left">
      <div class="hero-eyebrow">
        <div class="hero-location">
          <span class="loc-line"></span>
          Full Stack Developer · Lima, Peru
        </div>
        <div class="hero-thinking-pill">
          <span class="pulse-dot orange"></span>
          <span data-i18n="heroThinking">Thinking about: async patterns</span>
        </div>
      </div>
      <div class="hero-name">
        <div class="name-line-1">MANUEL</div>
        <div class="name-line-2">CUYA</div>
      </div>
      <p class="hero-subtitle" data-i18n="heroSubtitle">Building scalable web products — from the database layer to the final pixel.</p>
      <div class="hero-ctas">
        <a href="#projects" class="btn-split">
          <span class="btn-split-text" data-i18n="heroCta1">View My Work</span>
          <span class="btn-split-icon">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <a href="#contact" class="btn-outline">
          <span class="btn-outline-text" data-i18n="heroCta2">Get in Touch</span>
          <span class="btn-outline-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Status panel -->
    <div class="mc-hero-status hero-status">
      <div class="status-block status-availability">
        <div class="status-label">Status</div>
        <div class="status-val">
          <span class="pulse-dot green"></span>
          <span data-i18n="statusOpen">Open to work</span>
        </div>
      </div>
      <div class="status-block status-stats">
        <div class="stat-cell stat-cell-left">
          <div class="stat-label" data-i18n="expLabel">Experience</div>
          <div class="stat-num">2<span class="stat-unit"> yrs</span></div>
        </div>
        <div class="stat-cell">
          <div class="stat-label" data-i18n="shippedLabel">Shipped</div>
          <div class="stat-num">7<span class="stat-plus">+</span></div>
        </div>
      </div>
      <div class="status-block status-core">
        <div class="status-label" data-i18n="coreLabel">Core stack</div>
        <div class="core-tags">
          <span class="core-tag">TypeScript</span>
          <span class="core-tag">Node.js</span>
          <span class="core-tag">React</span>
          <span class="core-tag core-tag-accent">PostgreSQL</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll">
    <div class="scroll-hint" data-i18n="scroll">Scroll</div>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- ══ 01 ABOUT ════════════════════════════════════════ -->
<section id="about" class="section-light">
  <div data-grain class="grain-layer"></div>
  <div class="dashed-cols dashed-cols-light" aria-hidden="true">
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
  </div>
  <div class="mc-about-grid about-grid section-inner">
    <div data-reveal data-reveal-dir="left" class="about-text">
      <div class="section-header">
        <span class="section-num">01</span>
        <span class="section-rule"></span>
        <span class="section-title" data-i18n="navAbout">About</span>
      </div>
      <div class="about-body">
<p data-i18n="aboutP1">Full Stack Developer with a Civil Engineering background. I build web products end-to-end, automate processes and optimize integrations.</p>
       <p data-i18n="aboutP2">Analytical thinking, technical curiosity and a practical approach to solving complex problems.</p>
      </div>
      <div class="about-actions">
        <a href="https://drive.google.com/file/d/1eMad4C7ltI0FGdIfbvc7lXEKWXxM6YIf/view?usp=sharing" target="_blank" rel="noopener" class="btn-split btn-split-dark">
          <span class="btn-split-text" data-i18n="cvBtn">Download CV</span>
          <span class="btn-split-icon">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2v9M4 8l4 4 4-4M2 14h12" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <!-- BUG #1: btn-border-light tiene border gris claro sobre fondo claro — poco contraste y altura diferente al btn-split. Revisar si usar btn-outline o igualar altura/estilo con el botón de CV -->
        <a href="https://www.linkedin.com/in/mcuyaca/" target="_blank" rel="noopener" class="btn-border-light">LinkedIn →</a>
      </div>
    </div>
    <div data-reveal data-reveal-dir="right" class="about-photo-wrap">
      <img class="about-photo" src="/images/manuel.webp" alt="Manuel Cuya" width="800" height="1067" loading="lazy" decoding="async">
      <div class="photo-caption">
        <span class="photo-rule"></span>
        Manuel Cuya · Lima, Peru
        <span class="photo-rule"></span>
      </div>
    </div>
  </div>
</section>

<!-- ══ 02 STACK ════════════════════════════════════════ -->
<section id="stack" class="section-dark">
  <div class="dashed-cols dashed-cols-dark" aria-hidden="true">
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
  </div>

  <div class="mc-stack-pad stack-header section-inner">
    <div data-reveal>
      <div class="section-header section-header-light">
        <span class="section-num section-num-light">02</span>
        <span class="section-rule section-rule-light"></span>
        <span class="section-title section-title-light" data-i18n="navStack">Stack</span>
      </div>
    </div>
  </div>

  <!-- Marquees -->
  <div class="marquee-wrap">
    <div class="marquee-row marquee-row-border">
      <div class="marquee-fade marquee-fade-left"></div>
      <div class="marquee-fade marquee-fade-right"></div>
      <div class="marquee-track marquee-fwd">
        <!-- Row 1 — duplicated for seamless loop -->
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=react&theme=dark" width="40" height="40" alt="React"><span style="color:#61DAFB">React</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=ts&theme=dark" width="40" height="40" alt="TypeScript"><span style="color:#3178C6">TypeScript</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=nodejs&theme=dark" width="40" height="40" alt="Node.js"><span style="color:#539E43">Node.js</span></div>
<div class="marquee-item"><img src="https://skillicons.dev/icons?i=cs&theme=dark" width="40" height="40" alt="C#"><span style="color:#953CAD">C#</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=postgres&theme=dark" width="40" height="40" alt="PostgreSQL"><span style="color:#336791">PostgreSQL</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=angular&theme=dark" width="40" height="40" alt="Angular"><span style="color:#DD0031">Angular</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=astro&theme=dark" width="40" height="40" alt="Astro"><span style="color:#FF5D01">Astro</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=tailwind&theme=dark" width="40" height="40" alt="Tailwind"><span style="color:#38BDF8">Tailwind</span></div>

        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=react&theme=dark" width="40" height="40" alt="React"><span style="color:#61DAFB">React</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=ts&theme=dark" width="40" height="40" alt="TypeScript"><span style="color:#3178C6">TypeScript</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=nodejs&theme=dark" width="40" height="40" alt="Node.js"><span style="color:#539E43">Node.js</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=cs&theme=dark" width="40" height="40" alt="C#"><span style="color:#953CAD">C#</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=postgres&theme=dark" width="40" height="40" alt="PostgreSQL"><span style="color:#336791">PostgreSQL</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=angular&theme=dark" width="40" height="40" alt="Angular"><span style="color:#DD0031">Angular</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=astro&theme=dark" width="40" height="40" alt="Astro"><span style="color:#FF5D01">Astro</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=tailwind&theme=dark" width="40" height="40" alt="Tailwind"><span style="color:#38BDF8">Tailwind</span></div>
      </div>
    </div>
    <div class="marquee-row">
      <div class="marquee-fade marquee-fade-left"></div>
      <div class="marquee-fade marquee-fade-right"></div>
      <div class="marquee-track marquee-rev">
        <!-- Row 2 — duplicated for seamless loop -->
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=git&theme=dark" width="40" height="40" alt="Git"><span style="color:#F05032">Git</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=vscode&theme=dark" width="40" height="40" alt="VS Code"><span style="color:#007ACC">VS Code</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=html&theme=dark" width="40" height="40" alt="HTML5"><span style="color:#E34F26">HTML5</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=css&theme=dark" width="40" height="40" alt="CSS3"><span style="color:#1572B6">CSS3</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=js&theme=dark" width="40" height="40" alt="JavaScript"><span style="color:#F7DF1E">JavaScript</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=figma&theme=dark" width="40" height="40" alt="Figma"><span style="color:#F24E1E">Figma</span></div>
        <!-- duplicate -->
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=git&theme=dark" width="40" height="40" alt="Git"><span style="color:#F05032">Git</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=vscode&theme=dark" width="40" height="40" alt="VS Code"><span style="color:#007ACC">VS Code</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=html&theme=dark" width="40" height="40" alt="HTML5"><span style="color:#E34F26">HTML5</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=css&theme=dark" width="40" height="40" alt="CSS3"><span style="color:#1572B6">CSS3</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=js&theme=dark" width="40" height="40" alt="JavaScript"><span style="color:#F7DF1E">JavaScript</span></div>
        <div class="marquee-item"><img src="https://skillicons.dev/icons?i=figma&theme=dark" width="40" height="40" alt="Figma"><span style="color:#F24E1E">Figma</span></div>
      </div>
    </div>
  </div>

  <!-- 5-col stack grid -->
  <div class="section-inner stack-grid-wrap">
    <div data-reveal class="stack-grid">
      <div class="stack-col">
        <div class="stack-col-header">
          <span class="stack-accent-bar"></span>
          <span class="stack-cat-label">Frontend</span>
        </div>
        <div class="stack-items">
          <span class="stack-item stack-item-primary">Angular</span>
          <span class="stack-item stack-item-primary">React</span>
          <span class="stack-item">Next.js</span>
          <span class="stack-item">TypeScript</span>
          <span class="stack-item">Tailwind</span>
        </div>
      </div>
      <div class="stack-col">
        <div class="stack-col-header">
          <span class="stack-accent-bar"></span>
          <span class="stack-cat-label">Backend</span>
        </div>
        <div class="stack-items">
          <span class="stack-item stack-item-primary">Node.js</span>
          <span class="stack-item stack-item-primary">C#</span>
          <span class="stack-item">Express</span>
          <span class="stack-item">REST APIs</span>
        </div>
      </div>
      <div class="stack-col">
        <div class="stack-col-header">
          <span class="stack-accent-bar"></span>
          <span class="stack-cat-label">Database</span>
        </div>
        <div class="stack-items">
          <span class="stack-item stack-item-primary">PostgreSQL</span>
          <span class="stack-item stack-item-primary">MongoDB</span>
          <span class="stack-item">SQL</span>
          <span class="stack-item">Umzug</span>
        </div>
      </div>
      <div class="stack-col">
        <div class="stack-col-header">
          <span class="stack-accent-bar"></span>
          <span class="stack-cat-label">EDI</span>
        </div>
        <div class="stack-items">
          <span class="stack-item stack-item-primary">EDIFACT</span>
          <span class="stack-item stack-item-primary">XML</span>
          <span class="stack-item">JSON</span>
          <span class="stack-item">Babelway</span>
          <span class="stack-item">SFTP</span>
          <span class="stack-item">OAuth</span>
          <span class="stack-item">API Key</span>
        </div>
      </div>
      <div class="stack-col stack-col-last">
        <div class="stack-col-header">
          <span class="stack-accent-bar"></span>
          <span class="stack-cat-label">Tooling</span>
        </div>
        <div class="stack-items">
          <span class="stack-item stack-item-primary">Git</span>
          <span class="stack-item stack-item-primary">VS Code</span>
          <span class="stack-item">Figma</span>
          <span class="stack-item">Postman</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ 03 PROJECTS ═════════════════════════════════════ -->
<section id="projects" class="section-light">
  <div data-grain class="grain-layer"></div>
  <div class="dashed-cols dashed-cols-light" aria-hidden="true">
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
    <div class="dash-col"></div>
  </div>
  <div class="section-inner projects-inner">
    <!-- Header -->
    <div data-reveal class="projects-header">
      <div class="section-header">
        <span class="section-num">03</span>
        <span class="section-rule"></span>
        <span class="section-title" data-i18n="workLabel">Work</span>
      </div>
      <a href="https://github.com/mcuyaca" target="_blank" rel="noopener" class="link-muted" data-i18n="allProjects">All projects →</a>
    </div>

    <!-- Featured card -->
    <div data-reveal class="mc-projects-featured projects-featured">
      <!-- Left info -->
      <div class="proj-info">
        <div>
          <div class="proj-eyebrow">
            <span id="proj-num">01</span> · <span data-i18n="featured">Featured</span>
          </div>
          <div id="proj-title" class="proj-title">BOARDABLE</div>
          <p id="proj-desc" class="proj-desc">Kanban-style task manager for registered users — create boards, move tasks across panels and track status in real time.</p>
          <div id="proj-tags" class="proj-tags"></div>
        </div>
        <div class="proj-actions">
          <a id="proj-demo-link" href="#" target="_blank" rel="noopener" class="btn-split btn-split-dark btn-split-sm">
            <span class="btn-split-text" data-i18n="viewProject">View Project</span>
            <span class="btn-split-icon btn-split-icon-sm">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H5M13 3V11" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
          <a id="proj-github-link" href="#" target="_blank" rel="noopener" class="link-muted-sm">GitHub →</a>
        </div>
      </div>
      <!-- Right mockup -->
      <div id="proj-mockup-wrap" class="proj-mockup-wrap">
        <div class="proj-mockup-inner">
          <div id="mock-0" class="proj-img-slot">
            <img src="/images/boardable.png" alt="Boardable — Kanban task manager">
          </div>
          <div id="mock-1" class="proj-img-slot" style="display:none">
            <img src="/images/validify.png" alt="Validify — CSV to PostgreSQL">
          </div>
          <div id="mock-2" class="proj-img-slot" style="display:none">
            <img src="/images/codeable-keep.png" alt="Codeable Keep — Notes SPA">
          </div>
          <div id="mock-3" class="proj-img-slot" style="display:none">
            <img src="/images/angular-todo.png" alt="Angular Todo — Task manager">
          </div>
          <div id="mock-4" class="proj-img-slot" style="display:none">
            <img src="/images/doggy-dom-drawer.png" alt="DoggyDomDrawer — Image annotation">
          </div>
        </div>
      </div>
    </div>

    <!-- 5-col tabs -->
    <div class="mc-projects-tabs proj-tabs" id="proj-tabs">
      <div class="proj-tab proj-tab-active" data-proj="0">
        <div class="tab-num">01</div>
        <div class="tab-title">BOARDABLE</div>
        <div class="tab-meta">React · 2024</div>
      </div>
      <div class="proj-tab" data-proj="1">
        <div class="tab-num">02</div>
        <div class="tab-title">VALIDIFY</div>
        <div class="tab-meta">Node.js · 2024</div>
      </div>
      <div class="proj-tab" data-proj="2">
        <div class="tab-num">03</div>
        <div class="tab-title">CODEABLE KEEP</div>
        <div class="tab-meta">React · 2024</div>
      </div>
      <div class="proj-tab" data-proj="3">
        <div class="tab-num">04</div>
        <div class="tab-title">ANGULAR TODO</div>
