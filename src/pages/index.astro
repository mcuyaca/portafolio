<style is:global>
/* ── Reset ─────────────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;scroll-padding-top:64px;}
section[id]{scroll-margin-top:64px;}
body{font-family:'Space Grotesk',sans-serif;background:#EDECEA;overflow-x:hidden;cursor:none;}
html:not(.js-cursor) body{cursor:auto;}
::selection{background:oklch(62% 0.20 50 / 0.2);}
input,textarea{cursor:text;}
a,button{cursor:none;}

/* ── Color tokens ──────────────────────────────────── */
:root{
  --accent:oklch(62% 0.20 50);
  --dark:#0E0E0C;
  --ink:#111110;
  --cream:#F5F0E6;
  --warm:#EDECEA;
  --muted:#5A5650;
  --rule:#DEDAD1;
  --placeholder:#9A968E;
}

/* ── Keyframes ─────────────────────────────────────── */
@keyframes fadeUp{from{opacity:0;transform:translateY(32px);}to{opacity:1;transform:translateY(0);}}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
@keyframes slideLeft{from{opacity:0;transform:translateX(-24px);}to{opacity:1;transform:translateX(0);}}
@keyframes slideRight{from{opacity:0;transform:translateX(24px);}to{opacity:1;transform:translateX(0);}}
@keyframes scaleIn{from{opacity:0;transform:scale(0.94);}to{opacity:1;transform:scale(1);}}
@keyframes nameReveal{from{opacity:0;transform:translateY(40px) skewY(2deg);}to{opacity:1;transform:translateY(0) skewY(0);}}

/* Hero entrance — staggered */
.hero-location{animation:slideLeft 0.7s cubic-bezier(0.16,1,0.3,1) 0.1s both;}
.hero-thinking-pill{animation:fadeIn 0.6s ease 0.2s both;}
.name-line-1{animation:nameReveal 0.8s cubic-bezier(0.16,1,0.3,1) 0.25s both;}
.name-line-2{animation:nameReveal 0.8s cubic-bezier(0.16,1,0.3,1) 0.38s both;}
.hero-subtitle{animation:fadeUp 0.7s cubic-bezier(0.16,1,0.3,1) 0.5s both;}
.hero-ctas{animation:fadeUp 0.7s cubic-bezier(0.16,1,0.3,1) 0.62s both;}
.hero-status{animation:slideRight 0.8s cubic-bezier(0.16,1,0.3,1) 0.3s both;}

/* Card hover lifts */
.proj-tab{transition:background 0.18s,transform 0.18s;}
.proj-tab:hover{transform:translateY(-2px);}
.post-row{transition:background 0.18s,transform 0.15s;}
.exp-row{transition:transform 0.18s;}
.exp-row:hover{transform:translateX(4px);}

@keyframes grain{
  0%,100%{transform:translate(0,0);}
  10%{transform:translate(-3%,-4%);}
  20%{transform:translate(4%,3%);}
  30%{transform:translate(-2%,5%);}
  40%{transform:translate(5%,-2%);}
  50%{transform:translate(-4%,4%);}
  60%{transform:translate(3%,-5%);}
  70%{transform:translate(-5%,2%);}
  80%{transform:translate(4%,4%);}
  90%{transform:translate(-3%,-3%);}
}
@keyframes marquee{from{transform:translateX(0);}to{transform:translateX(-50%);}}
@keyframes marqueeRev{from{transform:translateX(-50%);}to{transform:translateX(0);}}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.25;}}
@keyframes preBar{from{width:0;}to{width:100%;}}
@keyframes diagDrift{from{transform:translate(0,0);}to{transform:translate(116px,116px);}}

/* ── Preloader ─────────────────────────────────────── */
#mc-preloader{
  position:fixed;inset:0;z-index:9999;
  background:var(--dark);
  display:flex;align-items:center;justify-content:center;
  flex-direction:column;gap:20px;
  transition:opacity 0.65s ease;
}
.pre-logo{font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:0.08em;color:var(--cream);}
.pre-track{width:180px;height:1px;background:rgba(245,240,230,0.1);overflow:hidden;}
.pre-bar{height:100%;background:var(--accent);animation:preBar 1.6s cubic-bezier(0.16,1,0.3,1) forwards;}
.pre-label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.14em;color:rgba(245,240,230,0.3);text-transform:uppercase;}

/* ── Progress bar ──────────────────────────────────── */
#mc-progress{
  position:fixed;top:0;left:0;height:5px;width:0%;
  background:var(--accent);z-index:1001;
  transition:width 80ms linear;pointer-events:none;
}

/* ── Cursor ────────────────────────────────────────── */
#mc-cursor{
  position:fixed;top:0;left:0;width:24px;height:24px;
  pointer-events:none;z-index:9998;
  transform:translate(-50%,-50%);
  transition:transform 0.15s ease,opacity 0.2s ease;
}
.cur-h{position:absolute;top:50%;left:0;right:0;height:2px;background:var(--accent);opacity:0.55;transform:translateY(-50%);}
.cur-v{position:absolute;left:50%;top:0;bottom:0;width:2px;background:var(--accent);opacity:0.55;transform:translateX(-50%);}

/* ── Nav ───────────────────────────────────────────── */
#mc-nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  height:64px;display:flex;align-items:center;padding:0 48px;
  background:rgba(14,14,12,0.94);backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(245,240,230,0.05);
}
.nav-brand{
  font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:500;
  color:var(--cream);text-decoration:none;margin-right:auto;letter-spacing:-0.01em;
}
.nav-links{display:flex;align-items:center;gap:28px;margin-right:32px;}
.nav-link{
  font-family:'Space Grotesk',sans-serif;font-size:12px;font-weight:500;
  color:rgba(245,240,230,0.45);text-decoration:none;
  letter-spacing:0.06em;text-transform:uppercase;
  transition:color 0.18s;
}
.nav-link:hover{color:var(--cream);}

/* Lang toggle */
#lang-toggle{
  display:inline-flex;align-items:center;gap:0;
  background:none;border:none;margin-right:8px;cursor:none;padding:0;
}
.lang-pill{
  font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;
  letter-spacing:0.1em;padding:5px 9px;
  color:rgba(245,240,230,0.3);
  border:1px solid rgba(245,240,230,0.1);
  transition:color 0.18s,border-color 0.18s;
}
.lang-pill:first-child{border-right:none;border-radius:3px 0 0 3px;}
.lang-pill:last-child{border-radius:0 3px 3px 0;}
.lang-active{color:var(--cream);border-color:rgba(245,240,230,0.25)!important;}

.nav-cta{
  display:inline-flex;align-items:stretch;height:36px;
  border-radius:4px;overflow:hidden;cursor:pointer;text-decoration:none;
}
.nav-cta-text{
  display:flex;align-items:center;padding:0 14px;
  background:rgba(245,240,230,0.06);border:1px solid rgba(245,240,230,0.10);
  color:var(--cream);font-family:'Space Grotesk',sans-serif;
  font-size:12px;font-weight:600;white-space:nowrap;
}
.nav-cta-arrow{
  display:flex;align-items:center;justify-content:center;
  width:36px;background:var(--accent);
}

/* ── Helpers ───────────────────────────────────────── */
.accent{color:var(--accent);}
.section-inner{
  position:relative;z-index:2;
  max-width:1280px;margin:0 auto;padding:96px 48px;
}
.section-light{position:relative;background:var(--warm);overflow:hidden;}
.section-dark{position:relative;background:var(--ink);overflow:hidden;}
.section-offwhite{position:relative;background:#FAFAF8;border-top:1px solid #ECEAE3;overflow:hidden;}

.grain-layer{
  position:absolute;inset:-60%;width:220%;height:220%;
  background-size:180px 180px;
  animation:grain 0.6s steps(1) infinite;
  pointer-events:none;mix-blend-mode:multiply;z-index:0;
}

/* dashed columns overlay */
.dashed-cols{
  position:absolute;inset:0;display:flex;
  justify-content:space-between;padding:0 48px;
  pointer-events:none;z-index:1;
}
.dash-col{width:0;height:100%;}
.dashed-cols-light .dash-col{border-left:1px dashed rgba(17,17,16,0.07);}
.dashed-cols-dark .dash-col{border-left:1px dashed rgba(245,240,230,0.04);}
.dashed-cols-offwhite .dash-col{border-left:1px dashed rgba(17,17,16,0.05);}

/* section header (NN ─── TITLE) */
.section-header{display:flex;align-items:center;gap:20px;}
.section-num{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--ink);}
.section-rule{display:block;width:32px;height:1.5px;background:rgba(17,17,16,0.2);}
.section-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,4vw,56px);line-height:1;color:var(--ink);letter-spacing:0.02em;}
