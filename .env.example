# Resend — email delivery for /api/contact
# Get it at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — server-side secret (verifies the token received from the form).
# Get it at: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile — public client-side site key.
# Safe to expose in frontend HTML. Currently hardcoded in src/pages/index.astro.
TURNSTILE_SITE_KEY=0x4AAAAAAA_xxxxxxxxxxxxxxxxxxxxxxxxxx